PATENT_RAG_ENV=local
PATENT_RAG_RAW_PATENT_DIR=patant
PATENT_RAG_PROCESSED_DIR=data/processed
PATENT_RAG_INDEXES_DIR=data/indexes
PATENT_RAG_GRAPH_DIR=data/graph
PATENT_RAG_LOG_LEVEL=INFO

# Configure these when RAG/LLM features are enabled.
PATENT_RAG_LLM_PROVIDER=dashscope
PATENT_RAG_LLM_MODEL=qwen-plus
PATENT_RAG_LLM_TEMPERATURE=0.2
PATENT_RAG_LLM_MAX_TOKENS=1200
PATENT_RAG_OPENAI_API_KEY=

# Embedding provider.
# Use `hashing` for offline tests, or `dashscope` for Qwen/DashScope embeddings.
PATENT_RAG_EMBEDDING_PROVIDER=hashing
PATENT_RAG_EMBEDDING_MODEL=text-embedding-v4
# PATENT_RAG_EMBEDDING_DIMENSION=1024
PATENT_RAG_DASHSCOPE_API_KEY=
PATENT_RAG_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
